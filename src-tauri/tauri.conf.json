{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aplay",
  "version": "0.1.0",
  "identifier": "com.gmail.karoyqiu.aplay",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "aPlay",
        "width": 900,
        "height": 128,
        "alwaysOnTop": true,
        "decorations": false,
        "dragDropEnabled": false,
        "shadow": true,
        "transparent": true,
        "useHttpsScheme": true,
        "visible": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      },
      "csp": {
        "default-src": ["'self'"],
        "connect-src": ["ipc:", "http://ipc.localhost", "https://ipc.localhost"],
        "img-src": ["'self'", "https:", "data:"],
        "media-src": ["asset:", "http://asset.localhost", "https://asset.localhost"],
        "style-src": ["'self'"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
