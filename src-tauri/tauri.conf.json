{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aplay",
  "version": "0.1.0",
  "identifier": "com.gmail.karoyqiu.aplay",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "aPlay",
        "width": 1000,
        "height": 200,
        "decorations": false,
        "dragDropEnabled": false,
        "shadow": true,
        "transparent": true,
        "useHttpsScheme": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
